{
  "name": "openadmin-kit-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "OpenAdmin Kit \u2014 a self-hosted, security-first admin toolkit for TypeScript/Express apps (pre-alpha).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "test:pack": "node scripts/pack-test.mjs",
    "example": "pnpm --filter express-basic-example start",
    "demo": "pnpm --filter express-sqlite-example start"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "express": "^5.1.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
