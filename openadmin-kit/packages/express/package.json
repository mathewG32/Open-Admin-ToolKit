{
  "name": "@openadminkit/express",
  "version": "0.0.1-prealpha",
  "description": "Express transport for OpenAdmin Kit: authenticated, authorized, audited admin API routes.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
